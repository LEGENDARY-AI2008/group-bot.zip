PORT=3000
PREFIX=.
# Name shown in the menu and replies
BOT_NAME=乂օռʟʏ숬ʍɨʟɛӼ乂
# Name of the bot's master (owner), shown in replies and .owner
MASTER_NAME=乂օռʟʏ숬ʍɨʟɛӼ乂
# Master's number(s), country code, digits only, comma separated. The master can
# use admin-only commands in any group the bot is in.
MASTER_NUMBERS=
# Max number of paired WhatsApp numbers this server will run
MAX_SESSIONS=20
# Where sessions and database are stored (point these at a disk on Render)
SESSIONS_DIR=./sessions
DB_PATH=./data/bot.db
